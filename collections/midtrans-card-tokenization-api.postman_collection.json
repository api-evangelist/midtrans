          "id": "a092b00d-019d-4859-8e43-900934a51812",
          "name": "Get a one-time card token",
          "request": {
            "name": "Get a one-time card token",
            "description": {
              "content": "Exchanges raw card data (or a saved `token_id`) for a one-time `token_id` used by the Core API charge. Authenticated with the public Client Key passed as the `client_key` query parameter - this endpoint is called from the browser so raw PAN never touches the merchant server.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_key",
                  "value": "<string>",
                  "description": "(Required) The merchant's public Client Key."
                },
                {
                  "disabled": false,
                  "key": "card_number",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "card_exp_month",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "card_exp_year",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "card_cvv",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "token_id",
                  "value": "<string>",
                  "description": "A previously saved token to re-tokenize with a CVV."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
